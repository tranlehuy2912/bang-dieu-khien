<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab Gio choi (truoc 27/9/2026 ten la Bang).

  Phuong an B cua mau H "Game bong bay" (anh Huy chon 16/11/2026):
   - GHIM TREN: dong ten (hai nut co chu "Tin cô", "Mở máy") va cong tac "Tablet | Laptop".
     Cong tac chi hien khi laptop da noi vao nha.
   - CUON, the con Tablet: canh bao, the chinh (trang thai, dong ho, nut phien, han muc ngay,
     hang cho gio, quy), the giu phut qua gio ngu, bai cho duyet va viec nha chua xong (dua len
     ngay duoi the chinh), de thi thu, bai dan do.
   - CUON, the con Laptop: the Laptop (TheLaptop). Tach ra de moi luc chi thay mot hang
     15' 30' 45' Khac Bot: truoc do hai hang giong het nam tren mot trang.

  Nut nao tac dong len cai gi thi nam trong the cua cai do. Nut luc do bam khong co tac dung
  thi an di chu khong de xam, xem BangFragment.ve.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="16dp">

        <!-- Dong dau: ten con, tinh trang duong truyen, va hai viec thinh thoang moi lam
             (dan tin cua co, mo toan bo may) thu gon thanh hai icon o goc phai. Truoc day
             hai viec do la hai nut chu nam cuoi tab. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tenCon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/baloo2_rat_dam"
                android:text="@string/child_name"
                android:textColor="@color/ink"
                android:textSize="26sp"
                app:fontFamily="@font/baloo2_rat_dam" />

            <View
                android:id="@+id/chamSong"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/cham" />

            <TextView
                android:id="@+id/pinMay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <!-- Tin cua co giao trong nhom lop Zalo. Ba Huy chep tin ben Zalo roi bam day,
                 tablet dua len man chinh cho con va ba noi doc. -->
            <!-- Tu 16/11/2026 co chu "Tin cô" canh bieu tuong: truoc do chi co bieu tuong, ten
                 nam trong tooltip, nhin khong biet nut lam gi. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutTinCo"
                style="@style/Nut.Nhan"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/bang_tin_co"
                android:text="Tin cô"
                android:tooltipText="@string/bang_tin_co"
                app:icon="@drawable/ic_tin_co" />

            <!-- Mo toan bo may, viec cua rieng Ba Huy. Bam vao chi mo hop chon bao lau,
                 nen lo tay cung chi can Huy. Luc dang mo thi an: nut dong nam trong the
                 chinh, canh dong ho cua che do do. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutMoMay"
                style="@style/Nut.Nhan"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/bang_mo_may"
                android:text="Mở máy"
                android:tooltipText="@string/bang_mo_may"
                app:icon="@drawable/ic_mo_may" />
        </LinearLayout>

        <!-- Cong tac Tablet | Laptop (16/11/2026). An khi laptop chua noi: luc do chi co tablet. -->
        <LinearLayout
            android:id="@+id/hangChonMay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutXemTablet"
                style="@style/Nut.Bong"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Tablet"
                android:textSize="17sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutXemLaptop"
                style="@style/Nut.Bong.Trang"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Laptop"
                android:textSize="17sp" />
        </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadingEdgeLength="20dp"
        android:fillViewport="true"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp">

      <LinearLayout
          android:id="@+id/khoiTablet"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">

        <!-- Bang canh bao: chi hien khi tablet mat lien lac hoac quyen bi tat. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/theCanhBao"
            style="@style/The"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/alert_soft"
            app:strokeColor="@color/alert">

            <TextView
                android:id="@+id/chuCanhBao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:textColor="@color/alert"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- The chinh: trang thai cong, dong ho dem nguoc, va moi nut dieu khien gio.
             Tablet khong tra loi thi the mo di: so trong the la cua lan cuoi tablet
             bao, khong phai bay gio. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/theChinh"
            style="@style/The"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Hai khoi so lieu (khoiTrangThai, khoiHanMuc) mo di khi tablet khong tra
                     loi. Nut thi khong mo: lenh van nam cho, tablet co mang lai la lam. -->
                <LinearLayout
                    android:id="@+id/khoiTrangThai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Dai ruy bang (mau H, 16/11/2026): nen mau trang thai ve trong code, xem
                         BangFragment.ve. -->
                    <TextView
                        android:id="@+id/nhanTrangThai"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/vien_nhan"
                        android:fontFamily="@font/baloo2_rat_dam"
                        android:paddingStart="16dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="9dp"
                        android:shadowColor="#33000000"
                        android:shadowDy="2"
                        android:shadowRadius="1"
                        android:text="@string/bang_dang_hoi"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        app:fontFamily="@font/baloo2_rat_dam" />

                    <!-- Tablet dang mo app gi. Ngay duoi nhan: nhan noi cong dang the
                         nao, dong nay noi con dang lam gi voi no. -->
                    <TextView
                        android:id="@+id/dangMo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <!-- Chu trang vien mau trang thai (mau H): ChuVien ve vien, mau vien dat
                         trong code. -->
                    <vn.huytl.bangdieukhien.ui.ChuVien
                        android:id="@+id/dongHo"
                        style="@style/Chu.So"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingHorizontal="4dp"
                        android:paddingBottom="6dp"
                        android:text="@string/bang_gach"
                        android:textColor="@android:color/white"
                        app:fontFamily="@font/coiny" />

                    <TextView
                        android:id="@+id/duoiDongHo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/ink_soft"
                        android:textSize="14sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/thanhPhien"
                        style="@style/Thanh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:trackColor="#E9EEF8"
                        app:trackCornerRadius="6dp"
                        app:trackThickness="12dp" />
                </LinearLayout>

                <!-- Nut cua phien dang chay, ngay duoi dong ho cua phien do. Chi hien
                     nut bam duoc luc nay: tablet khoa thi ca hang an di. -->
                <LinearLayout
                    android:id="@+id/hangPhien"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nutDung"
                        style="@style/Nut.Phien.Bong"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="Tạm dừng" />

                    <!-- Nut "Bớt 15'" tung nam o day, chi hien luc dang choi. Tu 8/10/2026 nut
                         "Bớt" do o cuoi hang cho gio ben duoi, bot duoc ca luc tam dung va luc
                         con phieu chua bat dau. -->

                    <!-- Chi hien luc dang mo toan bo may. Lenh DONG_MAY chi dong che do
                         Ba Huy, phien choi dang chay van chay tiep; Khoa ngay thi dong
                         luon ca phien. Rong hon nut Khoa: chia doi thi tren may 360dp chu
                         gay lam hai dong. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nutDongMay"
                        style="@style/Nut.Phien.Bong.Trang"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1.5"
                        android:text="Đóng chế độ Ba Huy" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nutKhoa"
                        style="@style/Nut.Phien.Bong.Do"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Khoá ngay" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/line" />

                <!-- So phut trong ngay, ngay tren hang nut cho gio. Ben trai la so duoc choi
                     (da choi cong dang giu, gom ca gio nguoi lon cho), trung hai khuc mau cua
                     thanh; ben phai la so con kiem duoc, trung phan trang. Thanh ve giong thanh
                     ngay o man chinh tablet tu 1/10/2026, xem ThanhNgay.

                     Ben phai chi de xem: tu 29/9/2026 tablet bo tran chung 135 phut, moi phan co
                     tran rieng, va so do la tong cac tran (215) tru so da duyet. Tablet ban cu
                     chua gui so da choi thi ca khoi hien nhu truoc, xem BangFragment.veNgay.

                     Chieu 7/10/2026 anh Huy bo cac chu giai thich: nhan "Được chơi hôm nay" tren
                     so ben trai, nhan "Còn kiếm được" tren so ben phai, dong cuoi "Đã duyệt bằng
                     bài N phút, tối đa M phút một ngày (tổng trần riêng của từng phần)", va nhan
                     "Cho chơi ngay" tren hang nut ben duoi. Chi con so, thanh, va dong cham mau
                     chuThichNgay (chi hien khi da choi hay con giu phut). -->
                <LinearLayout
                    android:id="@+id/khoiHanMuc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/duocChoi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ink"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:text="@string/bang_gach" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/conLaiNgay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ink"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:text="@string/bang_gach" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Vien ngoai va ruot tach hai lop (16/11/2026), xem nen_thanh_ngay_h. -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/nen_thanh_ngay_h"
                        android:padding="3dp">

                        <LinearLayout
                            android:id="@+id/khungNgay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/nen_ruot_thanh_ngay"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/phanDaChoi"
                                android:layout_width="0dp"
                                android:layout_height="match_parent" />

                            <View
                                android:id="@+id/phanCon"
                                android:layout_width="0dp"
                                android:layout_height="match_parent" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/chuThichNgay"
                        style="@style/Chu.Nho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Hang nut cho gio. Le tren 16dp thay cho nhan "Cho chơi ngay" (bo 7/10/2026).
                     Nut "Bớt" do o cuoi hang (anh Huy chot 8/10/2026): ke nut "Khác" xanh, go so
                     phut nhu nut "Khác" (bam la hien o go so), chieu nguoc lai thi mau nguoc lai. -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cho15"
                        style="@style/Nut.Nhanh"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="15'" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cho30"
                        style="@style/Nut.Nhanh"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="30'" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cho45"
                        style="@style/Nut.Nhanh"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="45'" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/choKhac"
                        style="@style/Nut.Nhanh"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="Khác" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/choBot"
                        style="@style/Nut.Nhanh.Do"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Bớt" />
                </LinearLayout>

                <!-- Quy gio choi (29/9/2026): phut Le Hoa lam tren may ma tran rieng cua phan do
                     da cat. Khong het han, Ba Huy cap bao nhieu va luc nao thi tuy; cap tu quy
                     khong tinh vao tran nao. Nam ngay duoi hang Cho choi ngay vi cung la mot
                     cach cho gio, va cung bi khoa trong luc lenh dang gui.

                     Tablet ban cu khong gui so quy thi ca hang an; quy bang 0 thi nut tat. Phan
                     so mo di khi tablet khong tra loi, y nhu khoiHanMuc. -->
                <LinearLayout
                    android:id="@+id/hangQuy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/khoiQuy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Chu.Nho"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bang_quy_gio" />

                        <TextView
                            android:id="@+id/soQuy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ink"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:text="@string/bang_gach" />
                    </LinearLayout>

                    <!-- Le trong 16dp thay cho 4dp cua Nut.Phien: nut nay dung mot minh, rong
                         theo chu, khong phai chia hang voi hai ba nut khac. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nutCapQuy"
                        style="@style/Nut.Phien"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/bang_cap_quy" />
                </LinearLayout>

                <!-- Hang "Xem Netflix" (7/10/2026) chuyen sang the Laptop ngay duoi the nay (8/10/2026,
                     anh Huy chon gop het viec voi laptop vao mot the), xem the_laptop.xml. -->

                <!-- Hang mo hay khoa web tren laptop (co tu sang 7/10/2026) chuyen sang tab Cai
                     dat chieu 7/10/2026, thanh muc Bat/Tat "Firefox chỉ được mở Netflix" (tu
                     9/10/2026 ten "Khoá web") trong nhom Laptop, xem CaiDatFragment. Cac hang de thi thu ra the rieng theDeThi
                     ngay duoi the nay (anh Huy chon cung ngay). -->

                <!-- Lenh dang tren duong di, hay vua hong. Nam cuoi the, ngay duoi cac
                     nut vua bam.

                     Truoc day cho nay khong co gi: bam mot nut la khong thay phan hoi nao
                     cho toi luc tablet lam xong va bao ve, con hong thi chi co mot cau
                     Toast troi qua. Ai cung bam hai lan. -->
                <TextView
                    android:id="@+id/chuGui"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="2dp"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- Lenh da len may chu ma tablet chua lay, moi lenh mot dong kem nut Rut
                     lai. Tablet lay lenh nao la xoa lenh do, nen dong nao con day la tablet
                     chua nhan. BangFragment ve khoi nay, xem LenhCho. -->
                <LinearLayout
                    android:id="@+id/hopLenhCho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Phut tablet giu toi luc het gio ngu (8/11/2026): Ba Huy cho hay bai lam xong trong
             gio ngu. Chi hien khi co, chi de doc. Anh Huy chon dat ngay duoi the chinh, tren the
             Laptop: the Bai dang cho nam duoi the Laptop va the de thi, sang ra phai cuon moi
             thay, ma day la cau tra loi cho nut Cho vua bam o the chinh. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/theGiuSang"
            style="@style/The"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/brand_soft"
            app:strokeColor="@color/brand">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingVertical="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bang"
                    app:tint="@color/brand_dark" />

                <TextView
                    android:id="@+id/chuGiuSang"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/brand_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bai dang cho: chi hien khi co, va bam vao la sang thang tab Bai tap. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/theBaiCho"
            style="@style/The"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingVertical="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/hinhBaiCho"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:paddingStart="11dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="14dp"
                    android:src="@drawable/ic_bai"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/chuBaiCho"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/muiBaiCho"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/nut_tron_vang"
                    android:importantForAccessibility="no"
                    android:paddingStart="8dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="11dp"
                    android:src="@drawable/ic_mui_phai_trang" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Viec nha chua xong: tablet dang khoa vi viec nha. Bam vao la sang tab Viec nha,
             noi co nut Xong tung viec. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/theViecCho"
            style="@style/The"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingVertical="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/hinhViecCho"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:paddingStart="11dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="14dp"
                    android:src="@drawable/ic_viec_nha"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bang_viec_cho"
                        android:textColor="@color/ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chuViecCho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/muiViecCho"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/nut_tron_vang"
                    android:importantForAccessibility="no"
                    android:paddingStart="8dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="11dp"
                    android:src="@drawable/ic_mui_phai_trang" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The de thi thu (anh Huy chon tach khoi the chinh ngay 7/10/2026): moi mon mot hang
             item_de_thi, thu tu Toan, KHTN, Tieng Anh, mon khong co de thi khong co hang.
             BangFragment.veDeThi dung hang bang code vi so mon di theo du lieu tablet gui. Tu
             1/10 toi 7/10/2026 cac hang nay nam trong the chinh, truoc nua la mot hang Tieng Anh
             ve san (30/9/2026). Tablet ban cu khong gui danh sach de thi thi ca the an.

             Khong co le tren: hang nao cung le tren 16dp (item_de_thi), hang dau lam luon le tren
             cua the. Lenh MODETHI vua gui van bao o chuGui cuoi the chinh, ngay tren the nay. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/theDeThi"
            style="@style/The"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/hopDeThi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Cac dong vo dan do chua toi han, gom theo buoi (hop/nhacbai). Tablet nhac Le Hoa
             tu hom truoc buoi han; the nay de Ba Huy thay cung danh sach do. Chi de doc. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/theNhacBai"
            style="@style/The"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_vo"
                        app:tint="@color/ink_soft" />

                    <TextView
                        style="@style/Chu.TieuDe"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/bang_nhac_bai" />
                </LinearLayout>

                <TextView
                    android:id="@+id/chuNhacBai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
      </LinearLayout>

      <LinearLayout
          android:id="@+id/khoiLaptop"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:visibility="gone">

        <!-- The Laptop (8/10/2026): phut Netflix, trang thai, nhan len tivi, chup man hinh, dang
             xuat, tat may. TheLaptop ve; an khi laptop chua noi vao nha. -->
        <include
            android:id="@+id/theLaptop"
            layout="@layout/the_laptop" />

      </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
