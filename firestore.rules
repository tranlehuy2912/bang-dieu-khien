rules_version = '2';

// Luat truy cap cho Firestore.
//
// Y chinh: mot "nha" la mot don vi kin. Tablet cua Le Hoa lap ra nha va tu ghi
// minh vao danh sach uids. Dien thoai cua Ba Huy muon vao phai xin qua cua
// /ghep, va chi tablet moi ket nap duoc - nen ke la co biet ma nha cung khong
// doc duoc gi.
//
// Dang nhap la an danh (Anonymous Auth): khong ai phai nho mat khau, nhung moi
// may van co mot uid rieng de luat o day bam vao.
service cloud.firestore {
  match /databases/{database}/documents {

    function laNguoiNha(nhaId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/nha/$(nhaId)).data.uids;
    }

    // Nguoi nha quyen han: may ba noi.
    //
    // Tach hai danh sach vi hai muc quyen khac han. Ai o trong uids thi go duoc moi
    // lenh, ke ca KHOA may hay tat quan tri thiet bi de go app. Ai o trong uidsPhu
    // thi chi giao viec nha - chan o day chu khong trong vao viec app ben may ba
    // khong hien nhung nut kia ra.
    //
    // Dung data.get(..., []) chu khong phai data.uidsPhu: nhung cai nha lap tu truoc
    // khong co truong do, ma cham thang vao mot truong khong ton tai thi ca bieu thuc
    // bao loi chu khong ra false - tuc la ca nha do tac cung.
    function laNguoiPhu(nhaId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/nha/$(nhaId))
             .data.get('uidsPhu', []);
    }

    match /nha/{nhaId} {

      // Lap nha. Chi cho tao khi nguoi tao tu ghi dung mot minh vao danh sach:
      // khong ai lap mot cai nha roi nhet san uid nguoi khac vao do.
      allow create: if request.auth != null
        && request.resource.data.uids == [request.auth.uid];

      // Doc duoc khi la nguoi nha, HOAC khi nha chua ton tai.
      //
      // Ve mat con ga qua trung: tablet phai doc mot cai xem nha co chua roi moi
      // biet co phai lap khong, nhung luc do no chua the la nguoi nha cua mot cai
      // nha chua co. Khong mo he nay thi lan chay dau tien tac cung, va trieu
      // chung la PERMISSION_DENIED o moi thu.
      //
      // Thu tu hai ve PHAI nhu duoi: exists() dung truoc de khi nha chua co thi
      // laNguoiNha khong duoc goi - goi vao la get() tra null, cham .data la ca
      // bieu thuc bao loi chu khong ra false.
      //
      // Cho khong nghia la lo: ke doc duoc cung chi biet mot ma nha hai muoi ky tu
      // ngau nhien la co ton tai hay khong, va chi trong dung khoang thoi gian truoc
      // khi tablet lap nha.
      allow read: if request.auth != null
        && (!exists(/databases/$(database)/documents/nha/$(nhaId)) || laNguoiNha(nhaId));

      allow update: if laNguoiNha(nhaId);
      allow delete: if false;

      // Cua xin vao nha.
      //
      // Phai mo rieng cho nay vi luc go ma ghep doi, dien thoai chua phai nguoi
      // nha - lay laNguoiNha ra chan thi khong ai vao duoc bao gio. Doi lai, moi
      // may chi dung duoc o mang ten uid cua chinh no, va noi dung trong do chi
      // la mot ma sau so; tablet doc ma, so voi ma no dang hien tren man hinh,
      // dung thi moi ket nap.
      match /ghep/{uid} {
        allow create: if request.auth != null && request.auth.uid == uid;
        allow read: if request.auth != null
          && (request.auth.uid == uid || laNguoiNha(nhaId));

        // Nguoi nha ket nap bang cach ghi trangThai vao day.
        //
        // Nhung may dang xin CUNG phai ghi lai duoc o cua chinh no: go sai ma mot
        // lan la o do da co trangThai = "SAI", va lan xin thu hai la mot lan GHI DE
        // chu khong con la tao moi - luat cu chan dung cho do, nen go sai mot lan la
        // khong bao gio xin lai duoc nua. Cho ghi de, voi dieu kien lan ghi do KHONG
        // mang theo trangThai: may xin duoc quyen hoi lai, khong duoc quyen tu tra
        // loi. Ma no co tu ghi "OK" thi cung chi lua duoc chinh no - danh sach nguoi
        // nha nam o document nha, ma cho do chi nguoi nha moi sua duoc.
        allow update: if laNguoiNha(nhaId)
          || (request.auth != null
              && request.auth.uid == uid
              && !("trangThai" in request.resource.data));
        allow delete: if laNguoiNha(nhaId);
      }

      // ---------------------------------------------------- may ba noi
      //
      // Hai cua duoi day mo rieng cho uidsPhu. Nguoi nha day du van di qua cua chung
      // o duoi cung; Firestore cho qua khi CO MOT luat nao do cho phep, nen hai cai
      // nay chi noi them chu khong bot cua ai. Cua doc hop/trangthai bo ngay 27/9/2026:
      // app ba khong con doc cho do tu khi bo nut cho gio (26/9/2026).
      //
      // KHONG CON CUA lenh/ CHO MAY BA. Truoc 26/9/2026 may ba tao duoc lenh CHO, 1
      // den 60 phut, cho sau nut cho gio. App ba bo sau nut do, va cua nay dong theo:
      // may ba khong tao duoc lenh nao nua, ke ca ban app cu con cai tren may.

      // Viec nha. May ba va Bang dieu khien cung ghi, moi lan bam la mot transaction
      // doc ban tren may chu roi moi ghi, nen may ba phai doc duoc. Bang dieu khien
      // la nguoi nha day du, di qua cua chung o duoi cung.
      match /hop/viecnha {
        allow read, write: if laNguoiPhu(nhaId);
      }

      // Danh sach viec de chon khi giao. Bang dieu khien sua, qua cua chung o duoi
      // cung; may ba chi doc. Chua co danh sach thi hai may dung chung danh sach mac
      // dinh viet san trong app.
      match /hop/danhsachviec {
        allow read: if laNguoiPhu(nhaId);
      }

      // Con lai - trang thai, lenh, bai, nhat ky, tin nhan - chi nguoi nha.
      match /{duong=**} {
        allow read, write: if laNguoiNha(nhaId);
      }
    }

    // Lich hoc cua mot nha (thoi khoa bieu va ngay nghi), tu 4/10/2026. Document mang dung
    // ma nha, mot truong "json".
    //
    // Dat ngoai /nha/{nhaId} vi cua chung o tren cho nguoi nha GHI moi thu ben trong, ma
    // Firestore cho qua khi co mot luat nao cho phep: dat lich trong do thi tablet cua Le Hoa
    // sua duoc lich de khoi bi chan. O day khong may nao ghi duoc. Claude Code ghi qua
    // Firebase console bang tai khoan cua Ba Huy, console khong di qua luat nay.
    match /lichhoc/{nhaId} {
      allow read: if laNguoiNha(nhaId);
      allow write: if false;
    }

    // Laptop xem Netflix cua Le Hoa (7/10/2026). Document mang dung ma nha, truong uidLaptop
    // la uid dang nhap an danh cua chuong trinh chay ngam tren laptop.
    //
    // Dat ngoai /nha/{nhaId} vi laptop khong phai nguoi nha: cho no vao uids la cho no ghi
    // moi thu trong nha, ke ca lenh cho tablet. O day no chi doc ghi duoc document nay va
    // cac phieu cap ben duoi. Document do Claude Code lap qua Firebase console (ghi uidLaptop),
    // khong app nao lap hay xoa duoc, va laptop khong tu doi uidLaptop duoc.
    //
    // laNguoiNha dung TRUOC laLaptop: document chua co thi get() trong laLaptop tra null,
    // cham .data la ca bieu thuc bao loi. Nguoi nha doc duoc ca khi chua co laptop, de
    // tablet va Bang dieu khien biet ma an nut.
    function laLaptop(nhaId) {
      return request.auth != null
        && request.auth.uid == get(/databases/$(database)/documents/laptop/$(nhaId))
             .data.get('uidLaptop', '');
    }

    match /laptop/{nhaId} {
      allow read: if laNguoiNha(nhaId) || laLaptop(nhaId);
      // Nguoi nha chi doi duoc moWeb (Ba Huy bam Mo web, Khoa web tren Bang dieu khien).
      allow update: if (laLaptop(nhaId)
          && request.resource.data.uidLaptop == resource.data.uidLaptop)
        || (laNguoiNha(nhaId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moWeb'])
          && request.resource.data.moWeb is bool);
      allow create, delete: if false;

      // Phieu cap gio Netflix. Nguoi nha tao (tablet khi Le Hoa doi phut choi, Bang dieu
      // khien khi Ba Huy cho them), laptop doc roi xoa sau khi cong gio. Khong ai sua phieu.
      match /cap/{id} {
        allow create: if laNguoiNha(nhaId)
          && request.resource.data.phut is int
          && request.resource.data.phut > 0
          && request.resource.data.phut <= 600;
        allow read, delete: if laNguoiNha(nhaId) || laLaptop(nhaId);
      }
    }
  }
}
