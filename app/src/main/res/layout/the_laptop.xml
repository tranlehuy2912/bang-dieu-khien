<?xml version="1.0" encoding="utf-8"?>
<!-- The Laptop o tab Gio choi. 8/10/2026 anh Huy chon cach B: gop het viec voi laptop vao mot the.
     9/10/2026 anh Huy chon "mau Moi": bay giong the tablet ngay tren (nhan trang thai, dong tai
     khoan, dong ho to, hai nut do, duong ke, hang 15' 30' 45' Khac Bot), bo dong "Hôm nay", bo dong
     ghi chu duoi dong ho va nhan "Phút Netflix" tren hang nut. TheLaptop ve va xu ly; an khi laptop
     chua noi vao nha. Cac lan dung laptop trong ngay o the "Thời gian dùng laptop" cua tab Nhat ky. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/theLaptop"
    style="@style/The"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Chu.TieuDe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Laptop" />

            <!-- Nhan trang thai nhu nhanTrangThai cua the tablet: mau Le Hoa khi xem Netflix, mau Ba
                 Huy khi tai khoan Admin dang dung, xam khi o man dang nhap, tat hay khong tra loi. -->
            <TextView
                android:id="@+id/nhanTrangThai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/vien_nhan"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/dongTaiKhoan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <!-- Phut Netflix con lai, dang xem thi dem lui tung giay nhu dong ho the tablet. -->
        <TextView
            android:id="@+id/soNetflix"
            style="@style/Chu.So"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/bang_gach" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutDangXuat"
                style="@style/Nut.Phien.Do"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Đăng xuất" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutTatMay"
                style="@style/Nut.Phien.Do"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Tắt máy" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/line" />

        <!-- Hang phut Netflix nhu hang cho gio cua tablet (anh Huy chot 9/10/2026): 15' 30' 45' gui
             phieu ngay, khong hoi lai; Khac va Bot mo o go so phut. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/them15"
                style="@style/Nut.Nhanh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="15'" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/them30"
                style="@style/Nut.Nhanh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="30'" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/them45"
                style="@style/Nut.Nhanh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="45'" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/themKhac"
                style="@style/Nut.Nhanh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Khác" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutBot"
                style="@style/Nut.Nhanh.Do"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Bớt" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Remote tivi (11/10/2026): mo man Remote, noi thang laptop qua Wi-Fi nha. Ba nut chia
                 rong theo do dai chu, khong thi tren may 360dp "Chụp màn hình" gay hai dong. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutRemote"
                style="@style/Nut.Phien"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="0.8"
                android:text="Remote" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutNhan"
                style="@style/Nut.Phien"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Thông báo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutChup"
                style="@style/Nut.Phien"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.35"
                android:text="Chụp màn hình" />
        </LinearLayout>

        <!-- Ket qua lenh vua lam: xanh la xong, do la hong hay bi bo. Lenh, phieu dang cho nam o
             hopCho ben duoi. -->
        <TextView
            android:id="@+id/chuLenh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Lenh, phieu cap/bot dang cho laptop nhan, moi dong mot nut "Rút lại" (9/10/2026), nhu
             khoi lenh cho tablet o the Gio choi. TheLaptop.veCho ve. -->
        <LinearLayout
            android:id="@+id/hopCho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
