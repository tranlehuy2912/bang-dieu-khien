<?xml version="1.0" encoding="utf-8"?>
<!-- Mot app trong so dung app: bao lau, va nhung khoang nao trong ngay.

     Khong co bieu tuong app nhu ben tablet: app nam tren tablet, may nay khong co
     hinh cua no. Thanh ngang chi de so nhanh app nay voi app kia, con so that nam
     ngay canh ten. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/appTen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/appTong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/appThanh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="1000"
        app:indicatorColor="@color/brand"
        app:trackColor="@color/brand_soft"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp" />

    <TextView
        android:id="@+id/appKhoang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/ink_soft"
        android:textSize="13sp" />
</LinearLayout>
