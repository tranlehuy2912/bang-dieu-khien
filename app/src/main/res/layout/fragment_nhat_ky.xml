<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab Nhat ky: chuyen gi da xay ra tren tablet hom nay. Ba the chi de doc: nhat ky tablet
  ghi, dung app gi, con hoi AI gi. Truoc 27/9/2026 ba the nay nam cuoi tab Bang, duoi ca
  phan dieu khien gio lan the Viec nha.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Dong dau, cung co voi dong ten con o tab Gio choi: ten ngay dang xem ("Hôm nay",
             "Hôm qua", "Thứ hai 06/10"), ngay ben phai. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tieuDeNgay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bang_hom_nay"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ngayXem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Bay ngay gan nhat (8/10/2026, anh Huy muon xem nhu trang "Thời gian dùng app"):
             doi ngay o day thi ca ba the ben duoi doi theo. Tablet giu nhat ky va so hoi AI
             tren Firestore dung bay ngay roi tu xoa. Ngang chu khong doc, nhu trang kia. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/hangNgay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Nhat ky cua ngay dang xem. Tu 8/10/2026 khong gioi han so dong, nen chi hien
             may dong moi nhat, bam Xem ca ngay moi mo het. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/The"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="8dp">

                <TextView
                    style="@style/Chu.TieuDe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bang_nhat_ky" />

                <LinearLayout
                    android:id="@+id/hopNhatKy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/nhatKyTrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/bang_chua_co_gi"
                    android:textColor="@color/ink_soft"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nutXemNhatKy"
                    style="@style/Nut.Chu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-12dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dung app gi hom nay. The chi tom tat; cham vao la sang trang co tung khoang
             gio cua bay ngay gan nhat. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/theSuDung"
            style="@style/The"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Chu.TieuDe"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/bang_dung_app" />

                    <TextView
                        android:id="@+id/suDungTong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textColor="@color/ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_mo_tiep"
                        app:tint="@color/ink_mo" />
                </LinearLayout>

                <!-- Cau noi vi sao chua co so: dang lay, tablet ban cu, dich vu tat. -->
                <TextView
                    android:id="@+id/suDungChu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/su_dung_dang_lay"
                    android:textColor="@color/ink_soft"
                    android:textSize="14sp" />

                <!-- Ba app lau nhat, moi app mot dong. -->
                <LinearLayout
                    android:id="@+id/suDungApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/khoiDai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <vn.huytl.bangdieukhien.ui.DaiNgay
                        android:id="@+id/suDungDai"
                        android:layout_width="match_parent"
                        android:layout_height="12dp" />

                    <!-- Moc gio duoi dai, giong man Dung app gi, luc nao: khong co moc thi
                         khong doc duoc vach nao nam o luc nao trong ngay. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0h"
                            android:textColor="@color/ink_mo"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center"
                            android:text="6h"
                            android:textColor="@color/ink_mo"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center"
                            android:text="12h"
                            android:textColor="@color/ink_mo"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center"
                            android:text="18h"
                            android:textColor="@color/ink_mo"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="24h"
                            android:textColor="@color/ink_mo"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Thoi gian dung laptop (9/10/2026, anh Huy chon mau B): tong theo tai khoan, dai 24 gio
             nhu the dung app, roi tung lan dung. An khi laptop chua noi vao nha. NhatKyFragment.veLaptop
             ve tu so ngay laptop/{maNha}/ngay/{ngay}. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/theLaptopNgay"
            style="@style/The"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    style="@style/Chu.TieuDe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thời gian dùng laptop" />

                <TextView
                    android:id="@+id/laptopTong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/laptopKhoiDai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <vn.huytl.bangdieukhien.ui.DaiNgay
                        android:id="@+id/laptopDai"
                        android:layout_width="match_parent"
                        android:layout_height="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0h"
                            android:textColor="@color/ink_mo"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center"
                            android:text="6h"
                            android:textColor="@color/ink_mo"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center"
                            android:text="12h"
                            android:textColor="@color/ink_mo"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center"
                            android:text="18h"
                            android:textColor="@color/ink_mo"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="24h"
                            android:textColor="@color/ink_mo"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Moi lan dung mot dong item_lan_dung_laptop. -->
                <LinearLayout
                    android:id="@+id/laptopLan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cau con hoi app AI hom nay. Tach khoi nhat ky: nhat ky la chuyen cong
             dong mo, con day la chu con go, can doc tung cau. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/The"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Chu.TieuDe"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/bang_hoi_ai" />

                    <TextView
                        android:id="@+id/soHoiAi"
                        style="@style/Chu.Nho"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/hoiAi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textIsSelectable="true"
                    android:text="@string/bang_chua_hoi_ai" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nutXemHoiAi"
                    style="@style/Nut.Chu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-12dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
