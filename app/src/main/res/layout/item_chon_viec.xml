<?xml version="1.0" encoding="utf-8"?>
<!-- Mot viec trong danh sach de giao: o tich, ten, so phut. Cham ca dong la tich.

     Truoc day moi dong co mot nut dac "Chon", bon dong la bon nut xanh dac nam chong
     len nhau, noi hon ca hang nut cho gio. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="-8dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingEnd="8dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/oTich"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:minWidth="0dp"
        android:minHeight="0dp" />

    <TextView
        android:id="@+id/tenViec"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:textColor="@color/ink"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/phutViec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/ink_mo"
        android:textSize="14sp" />
</LinearLayout>
