<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/thanhTren"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:navigationIcon="@drawable/ic_quay_lai"
        app:title="Bài đã nộp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/than"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </ScrollView>

    <!-- Hai nut duyet nam duoi cung, luon nhin thay du cuon den dau. Bai da xong thi
         thay bang mot nut Xoa, bai da xoa thi mot nut Khoi phuc. -->
    <LinearLayout
        android:id="@+id/khungNut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Duyet so phut khac so tren nut. Truoc day chi co cach giu lau nut Duyet, ma
             khong co chu nao noi ra cach do. Nam tren hang nut chu khong chen vao hang:
             tren may rong 360dp hang ba nut da chat. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nutSoPhutKhac"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="36dp"
            android:text="Chọn số phút khác"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutTuChoi"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/bai_tu_choi_nut"
                android:textColor="@color/alert"
                app:strokeColor="@color/alert" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutDuyet"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.6"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutXoa"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/bai_xoa_khoi_danh_sach"
                android:textColor="@color/ink_soft"
                android:visibility="gone"
                app:cornerRadius="16dp"
                app:strokeColor="@color/line" />

            <!-- Bai da xoa khoi danh sach, mo tu tam Bai da xoa: dua no ve lai. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutKhoiPhuc"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/bai_khoi_phuc_vao_danh_sach"
                android:visibility="gone"
                app:cornerRadius="16dp"
                app:strokeColor="@color/line" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
