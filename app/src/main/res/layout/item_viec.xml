<?xml version="1.0" encoding="utf-8"?>
<!-- Mot dong trong the Viec nha: ten viec va so phut ben trai, nut ben phai.

     Mot khuon cho ca hai canh: luc chon viec de giao (nut Chon) va luc dot dang
     chay (nut Bo va Xong). Giong dong viec tren may ba noi, chi nho hon: Ba Huy
     khong can chu to nhu ba. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tenViec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/phuViec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/ink_mo"
            android:textSize="13sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nutPhu"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nutChinh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:minWidth="92dp" />
</LinearLayout>
