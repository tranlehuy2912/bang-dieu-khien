<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab Gio choi (truoc 27/9/2026 ten la Bang), tu tren xuong: tablet dang the nao cung
  moi nut dieu khien gio (mot the), roi nhung viec dang cho Ba Huy (viec nha chua xong,
  bai cho duyet, vo dan do). Viec nha va nhat ky moi thu mot tab rieng.

  Nut nao tac dong len cai gi thi nam trong the cua cai do. Truoc day bay nut xep hang
  tren nen man hinh, moi hang mot nhan chu in hoa, va nhan nhieu toi muc khong con nhom
  nao noi len. Nut luc do bam khong co tac dung thi an di chu khong de xam, xem
  BangFragment.ve.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <!-- Dong dau: ten con, tinh trang duong truyen, va hai viec thinh thoang moi lam
             (dan tin cua co, mo toan bo may) thu gon thanh hai icon o goc phai. Truoc day
             hai viec do la hai nut chu nam cuoi tab. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tenCon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/child_name"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <View
                android:id="@+id/chamSong"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/cham" />

            <TextView
                android:id="@+id/pinMay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <!-- Tin cua co giao trong nhom lop Zalo. Ba Huy chep tin ben Zalo roi bam day,
                 tablet dua len man chinh cho con va ba noi doc. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutTinCo"
                style="@style/Nut.Icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/bang_tin_co"
                android:tooltipText="@string/bang_tin_co"
                app:icon="@drawable/ic_tin_co" />

            <!-- Mo toan bo may, viec cua rieng Ba Huy. Bam vao chi mo hop chon bao lau,
                 nen lo tay cung chi can Huy. Luc dang mo thi an: nut dong nam trong the
                 chinh, canh dong ho cua che do do. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutMoMay"
                style="@style/Nut.Icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="-6dp"
                android:contentDescription="@string/bang_mo_may"
                android:tooltipText="@string/bang_mo_may"
                app:icon="@drawable/ic_mo_may" />
        </LinearLayout>

        <!-- Bang canh bao: chi hien khi tablet mat lien lac hoac quyen bi tat. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/theCanhBao"
            style="@style/The"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/alert_soft"
            app:strokeColor="@color/alert">

            <TextView
                android:id="@+id/chuCanhBao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:textColor="@color/alert"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- The chinh: trang thai cong, dong ho dem nguoc, va moi nut dieu khien gio.
             Tablet khong tra loi thi the mo di: so trong the la cua lan cuoi tablet
             bao, khong phai bay gio. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/theChinh"
            style="@style/The"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Hai khoi so lieu (khoiTrangThai, khoiHanMuc) mo di khi tablet khong tra
                     loi. Nut thi khong mo: lenh van nam cho, tablet co mang lai la lam. -->
                <LinearLayout
                    android:id="@+id/khoiTrangThai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/nhanTrangThai"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/vien_nhan"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="@string/bang_dang_hoi" />

                    <!-- Tablet dang mo app gi. Ngay duoi nhan: nhan noi cong dang the
                         nao, dong nay noi con dang lam gi voi no. -->
                    <TextView
                        android:id="@+id/dangMo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/dongHo"
                        style="@style/Chu.So"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/bang_gach" />

                    <TextView
                        android:id="@+id/duoiDongHo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/ink_soft"
                        android:textSize="14sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/thanhPhien"
                        style="@style/Thanh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />
                </LinearLayout>

                <!-- Nut cua phien dang chay, ngay duoi dong ho cua phien do. Chi hien
                     nut bam duoc luc nay: tablet khoa thi ca hang an di. -->
                <LinearLayout
                    android:id="@+id/hangPhien"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nutDung"
                        style="@style/Nut.Phien"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="Tạm dừng" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nutBot"
                        style="@style/Nut.Phien"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="Bớt 15'" />

                    <!-- Chi hien luc dang mo toan bo may. Lenh DONG_MAY chi dong che do
                         Ba Huy, phien choi dang chay van chay tiep; Khoa ngay thi dong
                         luon ca phien. Rong hon nut Khoa: chia doi thi tren may 360dp chu
                         gay lam hai dong. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nutDongMay"
                        style="@style/Nut.Phien"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1.5"
                        android:text="Đóng chế độ Ba Huy" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nutKhoa"
                        style="@style/Nut.Phien.Do"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Khoá ngay" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/line" />

                <!-- So phut trong ngay, ngay tren hang nut cho gio. Ben trai la so duoc choi
                     (da choi cong dang giu, gom ca gio nguoi lon cho), trung hai khuc mau cua
                     thanh; ben phai la so con kiem duoc, trung phan trang. Thanh ve giong thanh
                     ngay o man chinh tablet tu 1/10/2026, xem ThanhNgay.

                     Ben phai chi de xem: tu 29/9/2026 tablet bo tran chung 135 phut, moi phan co
                     tran rieng, va so do la tong cac tran (215) tru so da duyet. Dong chu cuoi
                     noi ro so da duyet bang bai va con so tong, de khong ai doc ra mot han muc
                     chan nut Duyet. Tablet ban cu chua gui so da choi thi ca khoi hien nhu truoc,
                     xem BangFragment.veNgay. -->
                <LinearLayout
                    android:id="@+id/khoiHanMuc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/nhanDuocChoi"
                                style="@style/Chu.Nho"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/bang_duoc_choi_ngay" />

                            <TextView
                                android:id="@+id/duocChoi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ink"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:text="@string/bang_gach" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Chu.Nho"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/bang_con_lai_ngay" />

                            <TextView
                                android:id="@+id/conLaiNgay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ink"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:text="@string/bang_gach" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/khungNgay"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/nen_thanh_ngay"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/phanDaChoi"
                            android:layout_width="0dp"
                            android:layout_height="match_parent" />

                        <View
                            android:id="@+id/phanCon"
                            android:layout_width="0dp"
                            android:layout_height="match_parent" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/chuThichNgay"
                        style="@style/Chu.Nho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chuTranNgay"
                        style="@style/Chu.Nho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    style="@style/Chu.Nho"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/bang_cho_choi" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cho15"
                        style="@style/Nut.Nhanh"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="15'" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cho30"
                        style="@style/Nut.Nhanh"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="30'" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cho45"
                        style="@style/Nut.Nhanh"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="45'" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/choKhac"
                        style="@style/Nut.Nhanh"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Khác" />
                </LinearLayout>

                <!-- Quy gio choi (29/9/2026): phut Le Hoa lam tren may ma tran rieng cua phan do
                     da cat. Khong het han, Ba Huy cap bao nhieu va luc nao thi tuy; cap tu quy
                     khong tinh vao tran nao. Nam ngay duoi hang Cho choi ngay vi cung la mot
                     cach cho gio, va cung bi khoa trong luc lenh dang gui.

                     Tablet ban cu khong gui so quy thi ca hang an; quy bang 0 thi nut tat. Phan
                     so mo di khi tablet khong tra loi, y nhu khoiHanMuc. -->
                <LinearLayout
                    android:id="@+id/hangQuy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/khoiQuy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Chu.Nho"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bang_quy_gio" />

                        <TextView
                            android:id="@+id/soQuy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ink"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:text="@string/bang_gach" />
                    </LinearLayout>

                    <!-- Le trong 16dp thay cho 4dp cua Nut.Phien: nut nay dung mot minh, rong
                         theo chu, khong phai chia hang voi hai ba nut khac. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nutCapQuy"
                        style="@style/Nut.Phien"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/bang_cap_quy" />
                </LinearLayout>

                <!-- Hang de thi thu (30/9/2026): tom tat de nao dang mo, da lam may de, va nut mo
                     mot de cho Le Hoa. Tablet ban cu khong gui danh sach de thi thi ca hang an. -->
                <LinearLayout
                    android:id="@+id/hangDeThi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/khoiDeThi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Chu.Nho"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bang_de_thi" />

                        <TextView
                            android:id="@+id/chuDeThi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ink"
                            android:textSize="15sp"
                            android:text="@string/bang_gach" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nutMoDeThi"
                        style="@style/Nut.Phien"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/bang_mo_de_thi" />
                </LinearLayout>

                <!-- Lenh dang tren duong di, hay vua hong. Nam cuoi the, ngay duoi cac
                     nut vua bam.

                     Truoc day cho nay khong co gi: bam mot nut la khong thay phan hoi nao
                     cho toi luc tablet lam xong va bao ve, con hong thi chi co mot cau
                     Toast troi qua. Ai cung bam hai lan. -->
                <TextView
                    android:id="@+id/chuGui"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="2dp"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- Lenh da len may chu ma tablet chua lay, moi lenh mot dong kem nut Rut
                     lai. Tablet lay lenh nao la xoa lenh do, nen dong nao con day la tablet
                     chua nhan. BangFragment ve khoi nay, xem LenhCho. -->
                <LinearLayout
                    android:id="@+id/hopLenhCho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Viec nha chua xong: tablet dang khoa vi viec nha. Bam vao la sang tab Viec nha,
             noi co nut Xong tung viec. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/theViecCho"
            style="@style/The"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="@color/wait_soft"
            app:strokeColor="@color/wait">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingVertical="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_viec_nha"
                    app:tint="@color/wait_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bang_viec_cho"
                        android:textColor="@color/wait_ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chuViecCho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/wait_ink"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mo_tiep"
                    app:tint="@color/wait_ink" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bai dang cho: chi hien khi co, va bam vao la sang thang tab Bai tap. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/theBaiCho"
            style="@style/The"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="@color/wait_soft"
            app:strokeColor="@color/wait">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingVertical="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bai"
                    app:tint="@color/wait_ink" />

                <TextView
                    android:id="@+id/chuBaiCho"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/wait_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mo_tiep"
                    app:tint="@color/wait_ink" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cac dong vo dan do chua toi han, gom theo buoi (hop/nhacbai). Tablet nhac Le Hoa
             tu hom truoc buoi han; the nay de Ba Huy thay cung danh sach do. Chi de doc. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/theNhacBai"
            style="@style/The"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_vo"
                        app:tint="@color/ink_soft" />

                    <TextView
                        style="@style/Chu.TieuDe"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/bang_nhac_bai" />
                </LinearLayout>

                <TextView
                    android:id="@+id/chuNhacBai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
