<?xml version="1.0" encoding="utf-8"?>
<!-- Mot lan nop bai trong danh sach. Bam vao la mo man chi tiet. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/The"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/gio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nhan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/vien_nhan"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Chi hien o bai da xong. Bai dang cho thi con viec phai lam, khong xoa. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutXoa"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="36dp"
                android:paddingHorizontal="12dp"
                android:text="@string/bai_xoa"
                android:textColor="@color/ink_soft"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tomTat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/hangAnh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
