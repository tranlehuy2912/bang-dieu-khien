<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab Lich hoc (29/9/2026): thoi khoa bieu ca tuan cua Le Hoa, chi de xem. Tren cung la
  buoi dang hoc hay sap toi kem cac moc gio, duoi la luoi: cot la thu, hang la tiet, nhu
  man Thoi khoa bieu ben tablet.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Dong dau, cung co voi dong dau cac tab khac. Ben phai la tuan dang xem. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/lich_tieu_de"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tuanXem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Buoi toi. An khi khong con buoi nao (nghi he). -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/theBuoiToi"
            style="@style/The"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/nhanBuoiToi"
                    style="@style/Chu.Tieu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tenBuoiToi"
                    style="@style/Chu.TieuDe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/chiTietBuoiToi"
                    style="@style/Chu.Nho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/The"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="8dp"
                android:paddingEnd="4dp">

                <!-- Cot le trai: so tiet va gio. Gio moi tiet giong nhau o moi ngay nen
                     chi ghi mot lan o day. -->
                <LinearLayout
                    android:id="@+id/cotLe"
                    android:layout_width="46dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/luoi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
