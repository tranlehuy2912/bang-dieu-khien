<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Quyen duy nhat app nay xin. Khong may anh, khong danh ba, khong vi tri.
         Firestore va Telegram deu di qua mang, het. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BangDieuKhien">

        <!-- adjustResize de ban phim khong che mat o go chu o the Nhan. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.GhepDoiActivity"
            android:exported="false" />

        <activity
            android:name=".ui.BaiActivity"
            android:exported="false" />

        <activity
            android:name=".ui.XemAnhActivity"
            android:exported="false"
            android:theme="@style/Theme.BangDieuKhien.Anh" />
    </application>
</manifest>
