<?xml version="1.0" encoding="utf-8"?>
<!-- Mot dong trong hop sua danh sach viec nha: ten viec, so phut, nut xoa.

     Chep tu hop sua ben may ba noi, noi Ba Huy tung phai cam may ba len de sua. Loi
     cua ca dong hien duoi o ten: o phut hep qua, chu bao loi dat o do bi gay dong. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:baselineAligned="false"
    android:gravity="top"
    android:orientation="horizontal">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/khungTen"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="Tên việc">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/oTen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:hint="phút">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/oPhut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="3"
            android:maxLines="1"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nutXoa"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:contentDescription="Xoá việc này"
        app:icon="@drawable/ic_xoa_viec"
        app:iconSize="22dp"
        app:iconTint="@color/ink_soft" />
</LinearLayout>
