<?xml version="1.0" encoding="utf-8"?>
<!-- Hop "Nhắn lên tivi" cua the Laptop (8/10/2026): cau nhan toi da 200 ky tu, doc 1, 2 hay 3 lan,
     mac dinh 1 (anh Huy chot). TheLaptop.hoiNhan dung hop nay. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/khungChu"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Câu nhắn"
        app:counterEnabled="true"
        app:counterMaxLength="200">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/oChu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="200"
            android:minLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/Chu.Nho"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Đọc mấy lần" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/nhomSoLan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:checkedChip="@id/lan1"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/lan1"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 lần" />

        <com.google.android.material.chip.Chip
            android:id="@+id/lan2"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 lần" />

        <com.google.android.material.chip.Chip
            android:id="@+id/lan3"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 lần" />
    </com.google.android.material.chip.ChipGroup>
</LinearLayout>
