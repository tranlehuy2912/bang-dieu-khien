<?xml version="1.0" encoding="utf-8"?>
<!-- Hop "Màn hình laptop" (8/10/2026). Mo hop chi hien anh chup lan truoc, chua chup; bam nut Chup o
     duoi moi gui lenh chup (anh Huy doi 9/10/2026, truoc do mo hop la chup ngay). Nut dong la dau X
     o tren. Chi giu mot anh moi nhat, anh sau de anh truoc (anh Huy hoi lai 9/10/2026, giu nhu vay).
     TheLaptop.moAnh dung hop nay. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Màn hình laptop"
            android:textColor="@color/ink"
            android:textSize="20sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nutDong"
            style="@style/Nut.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Đóng"
            app:icon="@drawable/ic_dong" />
    </LinearLayout>

    <ImageView
        android:id="@+id/anh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:adjustViewBounds="true"
        android:background="@color/canvas"
        android:contentDescription="Màn hình laptop"
        android:minHeight="160dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/chuAnh"
        style="@style/Chu.Nho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nutChupAnh"
        style="@style/Nut.Vua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="12dp"
        android:text="Chụp" />
</LinearLayout>
