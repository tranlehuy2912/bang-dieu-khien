<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab Cai dat, phuong an B cua mau H "Game bong bay" (anh Huy chon 16/11/2026).

  GHIM TREN: tieu de va cong tac "Tablet | Laptop | Điện thoại" (nut Laptop chi hien khi laptop
  da noi vao nha). CUON: cac nhom cua trang dang chon, dung trong code (CaiDatFragment.ve).
  Truoc 16/11/2026 ca bay nhom (khoang 29 dong) nam tren mot trang cuon.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/baloo2_rat_dam"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp"
        android:text="Cài đặt"
        android:textColor="@color/ink"
        android:textSize="26sp"
        app:fontFamily="@font/baloo2_rat_dam" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nutTrangTablet"
            style="@style/Nut.Bong"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:text="Tablet"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nutTrangLaptop"
            style="@style/Nut.Bong.Trang"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:text="Laptop"
            android:textSize="16sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nutTrangMay"
            style="@style/Nut.Bong.Trang"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:text="Điện thoại"
            android:textSize="16sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadingEdgeLength="20dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/than"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp" />
    </ScrollView>
</LinearLayout>
