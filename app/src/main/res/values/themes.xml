<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BangDieuKhien" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <!-- De trong thi Material3 tu dat mau tim nhat cho may cho nay: o sang va icon
             cua the dang chon o thanh duoi, nen hop thoai, icon the chua chon. Lech han
             bang mau xanh cua app. -->
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSecondaryContainer">@color/brand_soft</item>
        <item name="colorOnSecondaryContainer">@color/brand_dark</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <!-- Hop thoai co bong thi Material3 pha mau xanh chu dao vao nen trang, ra mot mau
             xanh nhat khong co o dau khac trong app. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Man xem anh bai tap: nen den de nhin ro net chu but chi tren giay trang. -->
    <style name="Theme.BangDieuKhien.Anh" parent="Theme.BangDieuKhien">
        <item name="android:colorBackground">#0B0D11</item>
        <item name="android:statusBarColor">#0B0D11</item>
        <item name="android:navigationBarColor">#0B0D11</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="The" parent="Widget.Material3.CardView.Elevated">
        <!-- Chi dinh han mau nen, khong thi Material3 pha mau chu dao vao nen the. -->
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/line</item>
    </style>

    <style name="Chu.Tieu" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/ink_mo</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Ten the trong tab: "Nhat ky", "Dung app", "Hoi AI". Nam trong the, thay cho nhan
         chu in hoa dat tren the nhu truoc. -->
    <style name="Chu.TieuDe" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Chu nho mau nhat: nhan cua mot con so, dong phu duoi ten. -->
    <style name="Chu.Nho" parent="">
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Chu.So" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <!-- So dem nguoc doi tung giay. Chu khong deu be ngang thi ca dong nhay
             qua nhay lai moi lan chu so doi, nhin nhu man hinh bi giat. -->
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!--
      Nut cap gio: viec chinh cua man hinh nay, nen la nut dac mau chu dao.

      Le trong trai phai 8dp thay cho 24dp mac dinh cua Material. Bon nut chung mot hang
      tren may rong 360dp moi nut chi con 76dp; tru 48dp le thi con 28dp cho chu, va chu
      "Khác" gay thanh "Khá" voi "c". Hai nut Phien dung chung ly do. Dat ca left/right
      lan start/end vi style goc dat left/right.
    -->
    <style name="Nut.Nhanh" parent="Widget.Material3.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!--
      Nut "Bớt" o cuoi hang cho gio (8/10/2026): cung co va cung hang voi nut cho gio, nhung
      dac mau do. Anh Huy chot "nut bot mau do ke ben nut cho them Khac mau xanh": hai chieu
      nguoc nhau thi phai nhin ra truoc khi doc chu.
    -->
    <style name="Nut.Nhanh.Do">
        <item name="backgroundTint">@color/alert</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!--
      Nut dieu khien phien dang chay: tam dung, khoa (bot gio o day toi 8/10/2026).

      Nhat hon han nhom tren. Truoc day ca bay nut deu cung mot the tonal, cung co
      chu, xep hai hang lien nhau - ma "cho choi 45 phut" voi "bot 15 phut" thi
      nguoc chieu han nhau. Nhin phai ra hai nhom truoc khi doc chu.
    -->
    <style name="Nut.Phien" parent="Widget.Material3.Button.OutlinedButton">
        <!-- Ba nut nam trong the chinh nen hep hon luc con xep tren nen man. Chu 15sp
             le 8dp thi "Khoá ngay" gay hai dong tren may 360dp chu co 1,15. -->
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Nut nho mo danh sach bai da xoa: viec lau lau moi lam, nen mau nhat va vua chu. -->
    <style name="Nut.DaXoa" parent="Widget.Material3.Button.OutlinedButton.Icon">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="icon">@drawable/ic_xoa_viec</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconTint">@color/ink_mo</item>
        <item name="strokeColor">@color/line</item>
    </style>

    <!--
      Tam keo tu duoi len: nen cung mau nen man, cho the bai trang noi len nhu o danh
      sach chinh. Khong dat thi Material3 lay mau nen pha tim.

      Tat lop phu theo do cao: tam nam cao hon man chinh, va Material3 phu mot lop mau
      chu dao len moi the co nen trang nam tren no, ra the xanh nhat thay vi trang.
    -->
    <style name="ThemeOverlay.BangDieuKhien.TamDuoi" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/TamDuoi</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="TamDuoi" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/canvas</item>
    </style>

    <style name="Nut.Phien.Do">
        <item name="android:textColor">@color/chu_do</item>
        <item name="strokeColor">@color/vien_do</item>
    </style>

    <!-- Nut chu nho nam trong the: Sua danh sach, Bo, Xem ca ngay. -->
    <style name="Nut.Chu" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Nut.Chu.Do">
        <item name="android:textColor">@color/chu_do</item>
        <item name="rippleColor">@color/alert_soft</item>
    </style>

    <!-- Nut chi co icon o dong dau tab Gio choi: dan tin cua co, mo toan bo may. Ten viec
         nam trong contentDescription va tooltipText, nhan giu la hien. -->
    <style name="Nut.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">11dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">@color/ink_soft</item>
    </style>

    <!-- Nut dac co vua: Xong, Giao viec. Rong theo chu, khong keo het the. -->
    <style name="Nut.Vua" parent="Widget.Material3.Button">
        <item name="android:minWidth">88dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!--
      Thanh chay trong the chinh. Material3 tu ve nen thanh mau tim nhat va mot cham o
      cuoi thanh; ca hai deu khong mang y gi o day, lai lech mau cua app.
    -->
    <style name="Thanh" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackColor">@color/line</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="indicatorTrackGapSize">0dp</item>
    </style>
</resources>
