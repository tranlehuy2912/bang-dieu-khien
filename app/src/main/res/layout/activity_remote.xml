<?xml version="1.0" encoding="utf-8"?>
<!-- Man Remote (11/10/2026, anh Huy chon mau B trong ba mau ve): nua tren la ban di chuot, duoi la
     Bo gioi thieu, hang lui 10 giay, Dung/Phat, tien 10 giay, va hang am luong. Dong tren co nhan
     tinh trang noi, icon ban phim va icon ve man chon. RemoteActivity ve va xu ly. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/goc"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingTop="4dp">

        <Button
            android:id="@+id/nutVe"
            style="@style/Nut.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Quay lại"
            app:icon="@drawable/ic_quay_lai"
            app:iconTint="@color/ink" />

        <TextView
            style="@style/Chu.TieuDe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remote"
            android:textSize="18sp" />

        <!-- Tinh trang noi: xanh la da noi, vang dang noi, do la khong noi duoc (bam de noi lai). -->
        <TextView
            android:id="@+id/nhanNoi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/vien_nhan"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/nutBanPhim"
            style="@style/Nut.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Gõ chữ lên tivi"
            android:tooltipText="Gõ chữ lên tivi"
            app:icon="@drawable/ic_ban_phim" />

        <Button
            android:id="@+id/nutManChon"
            style="@style/Nut.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Về màn chọn Netflix, YouTube"
            android:tooltipText="Về màn chọn Netflix, YouTube"
            app:icon="@drawable/ic_man_chon" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/khungDiChuot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/nen_ban_di_chuot">

        <vn.huytl.bangdieukhien.ui.BanDiChuot
            android:id="@+id/banDiChuot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Bàn di chuột" />

        <LinearLayout
            android:id="@+id/goiY"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_cham"
                app:tint="@color/ink_mo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Vuốt: di chuột\nChạm: bấm\nHai ngón: cuộn"
                android:textColor="@color/ink_mo"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nutBoQua"
        style="@style/Nut.DaXoa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="Bỏ giới thiệu"
        android:textColor="@color/ink"
        app:icon="@drawable/ic_bo_qua"
        app:iconTint="@color/ink_soft" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutLui"
                style="@style/Nut.Tron"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Lùi 10 giây"
                app:icon="@drawable/ic_remote_quay"
                app:iconSize="34dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:text="10"
                android:textColor="@color/ink"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nutPhat"
            style="@style/Nut.Tron.Dac"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginHorizontal="32dp"
            android:contentDescription="Dừng hay phát"
            app:icon="@drawable/ic_remote_phat"
            app:iconSize="36dp" />

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">

            <!-- Cung hinh mui ten nut lui, lat nguoc. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nutTien"
                style="@style/Nut.Tron"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Tiến 10 giây"
                android:scaleX="-1"
                app:icon="@drawable/ic_remote_quay"
                app:iconSize="34dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:text="10"
                android:textColor="@color/ink"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nutNho"
            style="@style/Nut.Tron"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="Giảm âm lượng"
            app:icon="@drawable/ic_bot"
            app:iconSize="22dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:gravity="center"
            android:minWidth="88dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconLoa"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_loa"
                app:tint="@color/ink_soft" />

            <TextView
                android:id="@+id/chuAm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFeatureSettings="tnum"
                android:text="--"
                android:textColor="@color/ink"
                android:textSize="16sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nutTo"
            style="@style/Nut.Tron"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="Tăng âm lượng"
            app:icon="@drawable/ic_them"
            app:iconSize="22dp" />
    </LinearLayout>
</LinearLayout>
