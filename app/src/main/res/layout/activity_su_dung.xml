<?xml version="1.0" encoding="utf-8"?>
<!-- Le Hoa dung app gi, tu may gio den may gio, bay ngay gan nhat. Chep bo cuc trang
     cung ten ben tablet. Chi de doc: nut duy nhat la doi ngay dang xem. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/thanhTren"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:navigationIcon="@drawable/ic_quay_lai"
        app:title="@string/su_dung_title" />

    <!-- Bay ngay gan nhat. Ngang chu khong doc: bay o doc mot dong la het, ma cuon
         doc thi cai can bam nhat lai troi len tren mat. -->
    <HorizontalScrollView
        android:id="@+id/cuonNgay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/hangNgay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/than"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/theTong"
                style="@style/The"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/chuTong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ink"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chuKhungGio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/ink_soft"
                        android:textSize="14sp" />

                    <!-- Ca ngay thanh mot dai, moi khoang cam may la mot vach. Danh sach
                         duoi noi app nao bao lau; cai nay noi LUC NAO. -->
                    <vn.huytl.bangdieukhien.ui.DaiNgay
                        android:id="@+id/daiNgay"
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:layout_marginTop="16dp" />

                    <LinearLayout
                        android:id="@+id/hangGio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0h"
                            android:textColor="@color/ink_soft"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="6h"
                            android:textColor="@color/ink_soft"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="12h"
                            android:textColor="@color/ink_soft"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="18h"
                            android:textColor="@color/ink_soft"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="24h"
                            android:textColor="@color/ink_soft"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/theDanhSach"
                style="@style/The"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:id="@+id/danhSach"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="4dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Vi sao khong co dong nao. Mot trang trang tron nhin nhu "khong dung gi",
                 trong khi ly do hay gap hon la tablet chua gui, hay dich vu canh app
                 ben do dang tat. -->
            <TextView
                android:id="@+id/chuTrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/ink_soft"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chuGhiChu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/ink_mo"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
