<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BangDieuKhien" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <!-- De trong thi Material3 tu dat mau tim nhat cho may cho nay: o sang va icon
             cua the dang chon o thanh duoi, nen hop thoai, icon the chua chon. Lech han
             bang mau xanh cua app. -->
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <!-- O dang chon o thanh duoi: vang nhat chu xanh muc, nhu nut vang cua mau H. -->
        <item name="colorSecondaryContainer">@color/vang_nhat</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <!-- Hop thoai co bong thi Material3 pha mau xanh chu dao vao nen trang, ra mot mau
             xanh nhat khong co o dau khac trong app. -->
        <item name="elevationOverlayEnabled">false</item>
        <!-- Mau H "Game bong bay" (anh Huy chon 16/11/2026): nen troi xanh co may, chu Baloo 2
             cho ca app (dat o theme thi moi TextView, nut deu nhan), Coiny cho so to va nut bong. -->
        <item name="android:windowBackground">@drawable/nen_troi</item>
        <item name="android:fontFamily">@font/baloo2</item>
        <item name="fontFamily">@font/baloo2</item>
        <item name="materialButtonOutlinedStyle">@style/Nut.Vien</item>
        <item name="android:statusBarColor">@color/troi_tren</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Man xem anh bai tap: nen den de nhin ro net chu but chi tren giay trang. -->
    <style name="Theme.BangDieuKhien.Anh" parent="Theme.BangDieuKhien">
        <item name="android:colorBackground">#0B0D11</item>
        <item name="android:statusBarColor">#0B0D11</item>
        <item name="android:navigationBarColor">#0B0D11</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Xem anh man hinh laptop to ca man hinh (XemAnhLaptop, 29/10/2026). La mot Dialog phu kin man
         hinh, ve ca duoi thanh trang thai. Cua so trong suot, khong lam toi, khong hieu ung mo hop:
         nen den va anh bay ra do XemAnhLaptop tu ve, de luc dau con thay hop "Màn hình laptop" o duoi. -->
    <style name="Theme.BangDieuKhien.XemAnhLaptop" parent="Theme.BangDieuKhien">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="The" parent="Widget.Material3.CardView.Elevated">
        <!-- Chi dinh han mau nen, khong thi Material3 pha mau chu dao vao nen the. -->
        <item name="cardBackgroundColor">@color/surface</item>
        <!-- Mau H (16/11/2026): bo tron hon, bo vien, noi len troi bang bong xanh. -->
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">5dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:outlineSpotShadowColor">@color/bong_the</item>
        <item name="android:outlineAmbientShadowColor">@color/bong_the</item>
    </style>

    <!--
      Nut bong cua mau H "Game bong bay" (anh Huy chon 16/11/2026): hinh nen ve san o
      drawable/nut_bong_*.xml, chu Coiny trang co bong. Gan bang style="@style/Nut.Bong" tren tung
      nut dac. KHONG dat lam materialButtonStyle cua theme: Android lay style mac dinh do de lap
      moi thuoc tinh ma style rieng cua nut khong khai, nen nut chu cua hop thoai (TextButton)
      cung an phong Coiny, bong chu va ca hinh nen bong (thay ngay 16/11/2026). backgroundTint phai la @null, khong thi MaterialButton to phang ca hinh nen. Doi mau
      thi dung style con (.XanhLa, .Cam, .Do, .Vang, .Trang) chu dung backgroundTint.
      Hinh nen da co mep day 5dp, nen chu dat cao hon giua mot chut (padding duoi lon hon tren).
    -->
    <style name="Nut.Bong" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/nut_bong_xanh</item>
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:fontFamily">@font/coiny</item>
        <item name="fontFamily">@font/coiny</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/chu_nut_bong</item>
        <item name="android:shadowColor">#40000000</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">1</item>
        <item name="iconTint">@color/chu_nut_bong</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Nut.Bong.XanhLa">
        <item name="android:background">@drawable/nut_bong_xanhla</item>
    </style>

    <style name="Nut.Bong.Cam">
        <item name="android:background">@drawable/nut_bong_cam</item>
    </style>

    <style name="Nut.Bong.Do">
        <item name="android:background">@drawable/nut_bong_do</item>
    </style>

    <style name="Nut.Bong.Vang">
        <item name="android:background">@drawable/nut_bong_vang</item>
    </style>

    <!-- Nut phu: than trang, chu xanh muc, khong bong chu. Thay cho TonalButton. -->
    <style name="Nut.Bong.Trang">
        <item name="android:background">@drawable/nut_bong_trang</item>
        <item name="android:textColor">@color/ink</item>
        <item name="iconTint">@color/ink</item>
        <item name="android:shadowRadius">0</item>
        <item name="android:shadowDy">0</item>
    </style>

    <!-- Nut vien (materialButtonOutlinedStyle): nen trang de noi tren troi xanh, vien day 2dp. -->
    <style name="Nut.Vien" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">#D3DCEE</item>
        <item name="android:textColor">@color/brand_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">18dp</item>
    </style>


    <style name="Chu.Tieu" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/ink_mo</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Ten the trong tab: "Nhat ky", "Dung app", "Hoi AI". Nam trong the, thay cho nhan
         chu in hoa dat tren the nhu truoc. -->
    <style name="Chu.TieuDe" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Chu nho mau nhat: nhan cua mot con so, dong phu duoi ten. -->
    <style name="Chu.Nho" parent="">
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Chu.So" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textColor">@color/ink</item>
        <!-- Coiny (mau H): chi co mot do dam, dat bold thi may ve dam gia. -->
        <item name="android:fontFamily">@font/coiny</item>
        <item name="fontFamily">@font/coiny</item>
        <item name="android:textStyle">normal</item>
        <!-- So dem nguoc doi tung giay. Chu khong deu be ngang thi ca dong nhay
             qua nhay lai moi lan chu so doi, nhin nhu man hinh bi giat. -->
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!--
      Nut cap gio: viec chinh cua man hinh nay, nen la nut dac mau chu dao.

      Le trong trai phai 8dp thay cho 24dp mac dinh cua Material. Bon nut chung mot hang
      tren may rong 360dp moi nut chi con 76dp; tru 48dp le thi con 28dp cho chu, va chu
      "Khác" gay thanh "Khá" voi "c". Hai nut Phien dung chung ly do. Dat ca left/right
      lan start/end vi style goc dat left/right.
    -->
    <style name="Nut.Nhanh" parent="Nut.Bong">
        <item name="android:textSize">17sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <!--
      Nut "Bớt" o cuoi hang cho gio (8/10/2026): cung co va cung hang voi nut cho gio, nhung
      dac mau do. Anh Huy chot "nut bot mau do ke ben nut cho them Khac mau xanh": hai chieu
      nguoc nhau thi phai nhin ra truoc khi doc chu.
    -->
    <style name="Nut.Nhanh.Do">
        <item name="android:background">@drawable/nut_bong_do</item>
    </style>

    <!--
      Nut dieu khien phien dang chay: tam dung, khoa (bot gio o day toi 8/10/2026).

      Nhat hon han nhom tren. Truoc day ca bay nut deu cung mot the tonal, cung co
      chu, xep hai hang lien nhau - ma "cho choi 45 phut" voi "bot 15 phut" thi
      nguoc chieu han nhau. Nhin phai ra hai nhom truoc khi doc chu.
    -->
    <style name="Nut.Phien" parent="Nut.Vien">
        <!-- Ba nut nam trong the chinh nen hep hon luc con xep tren nen man. Chu 15sp
             le 8dp thi "Khoá ngay" gay hai dong tren may 360dp chu co 1,15. -->
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Nut nho mo danh sach bai da xoa: viec lau lau moi lam, nen mau nhat va vua chu. -->
    <style name="Nut.DaXoa" parent="Widget.Material3.Button.OutlinedButton.Icon">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="icon">@drawable/ic_xoa_viec</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconTint">@color/ink_mo</item>
        <item name="strokeColor">@color/line</item>
    </style>

    <!--
      Tam keo tu duoi len: nen cung mau nen man, cho the bai trang noi len nhu o danh
      sach chinh. Khong dat thi Material3 lay mau nen pha tim.

      Tat lop phu theo do cao: tam nam cao hon man chinh, va Material3 phu mot lop mau
      chu dao len moi the co nen trang nam tren no, ra the xanh nhat thay vi trang.
    -->
    <style name="ThemeOverlay.BangDieuKhien.TamDuoi" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/TamDuoi</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="TamDuoi" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/canvas</item>
    </style>

    <!-- Nut cua the Laptop (8/10/2026): chip vien xanh, nam trong ChipGroup de tu xuong dong vi nam
         nut khong vua mot hang tren may 360dp. -->
    <style name="Chip.Laptop" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="chipStrokeColor">@color/brand</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:textSize">14sp</item>
        <item name="chipIconVisible">false</item>
    </style>

    <style name="Chip.Laptop.Do">
        <item name="chipStrokeColor">@color/vien_do</item>
        <item name="android:textColor">@color/chu_do</item>
    </style>

    <style name="Nut.Phien.Do">
        <item name="android:textColor">@color/chu_do</item>
        <item name="strokeColor">@color/vien_do</item>
    </style>

    <!-- Nut chu nho nam trong the: Sua danh sach, Bo, Xem ca ngay. -->
    <style name="Nut.Chu" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Nut.Chu.Do">
        <item name="android:textColor">@color/chu_do</item>
        <item name="rippleColor">@color/alert_soft</item>
    </style>

    <!-- Nut chi co icon o dong dau tab Gio choi: dan tin cua co, mo toan bo may. Ten viec
         nam trong contentDescription va tooltipText, nhan giu la hien. -->
    <style name="Nut.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">11dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">@color/ink_soft</item>
    </style>

    <!-- Nut dac co vua: Xong, Giao viec. Rong theo chu, khong keo het the. -->
    <style name="Nut.Vua" parent="Nut.Bong">
        <item name="android:minWidth">88dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!--
      Nut tron chi co icon o man Remote (11/10/2026): lui, tien 10 giay, am luong. Vien nhat, to
      vua ngon cai vi luc bam mat nhin tivi chu khong nhin dien thoai. Co nut dat theo layout.
    -->
    <style name="Nut.Tron" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/ink</item>
        <item name="strokeColor">@color/line</item>
        <item name="shapeAppearance">@style/HinhTron</item>
    </style>

    <!-- Nut Dung/Phat cua man Remote: nut bam nhieu nhat, dac mau chu dao. -->
    <style name="Nut.Tron.Dac" parent="Widget.Material3.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@android:color/white</item>
        <item name="shapeAppearance">@style/HinhTron</item>
    </style>

    <style name="HinhTron" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!--
      Thanh chay trong the chinh. Material3 tu ve nen thanh mau tim nhat va mot cham o
      cuoi thanh; ca hai deu khong mang y gi o day, lai lech mau cua app.
    -->
    <style name="Thanh" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackColor">@color/line</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="indicatorTrackGapSize">0dp</item>
    </style>
</resources>
